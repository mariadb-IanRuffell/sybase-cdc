+package org.apache.ignite.internal.sql.engine.exec.execute;
+
+import java.util.List;
+import org.apache.ignite.internal.sql.engine.sql.IgniteSqlExecute;
+import org.apache.ignite.internal.tostring.S;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * SQL {@code EXECUTE} command: run a compute job and return its result.
+ */
+public class ExecuteCommand {
+    private final String jobClassName;
+
+    private final List<String> units;
+
+    private final @Nullable String args;
+
+    /** Constructor. */
+    public ExecuteCommand(String jobClassName, List<String> units, @Nullable String args) {
+        this.jobClassName = jobClassName;
+        this.units = List.copyOf(units);
+        this.args = args;
+    }
+
+    /** Creates the command from the AST node. */
+    public static ExecuteCommand fromSqlCall(IgniteSqlExecute sqlExecute) {
+        String jobClass = sqlExecute.jobClass().getValueAs(String.class);
+
+        assert jobClass != null;
+
+        return new ExecuteCommand(
+                jobClass,
+                sqlExecute.units(),
+                sqlExecute.args() == null ? null : sqlExecute.args().getValueAs(String.class)
+        );
+    }
+
+    public String jobClassName() {
+        return jobClassName;
+    }
+
+    /** Deployment units, each as {@code name:version}. */
+    public List<String> units() {
+        return units;
+    }
+
+    public @Nullable String args() {
+        return args;
+    }
+
+    @Override
+    public String toString() {
+        return S.toString(ExecuteCommand.class, this);
