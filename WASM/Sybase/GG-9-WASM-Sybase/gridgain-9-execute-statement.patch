+
+package org.apache.ignite.internal.sql.engine.sql;
+
+import static org.apache.ignite.internal.sql.engine.util.SqlTestUtils.assertThrowsSqlException;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+import java.util.List;
+import org.apache.calcite.sql.SqlNode;
+import org.apache.ignite.internal.sql.engine.SqlQueryType;
+import org.apache.ignite.internal.sql.engine.util.Commons;
+import org.apache.ignite.lang.ErrorGroups.Sql;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+/** Tests for EXECUTE SQL statement. */
+public class SqlExecuteParserTest extends AbstractParserTest {
+    @Test
+    public void jobClassOnly() {
+        String stmt = "EXECUTE 'org.example.MyJob'";
+
+        IgniteSqlExecute execute = assertInstanceOf(IgniteSqlExecute.class, parse(stmt));
+
+        assertEquals("org.example.MyJob", execute.jobClass().toValue());
+        assertEquals(List.of(), execute.units());
+        assertNull(execute.args());
+        assertEquals(SqlQueryType.EXECUTE, Commons.getQueryType(execute));
+
+        expectUnparsed(execute, stmt);
+    }
+
+    @Test
+    public void unitsAndArgs() {
+        String stmt = "EXECUTE 'org.example.MyJob' UNITS 'a:1.0.0', 'b:2.0.0' ARGS '{\"x\":1}'";
+
+        SqlNode node = parse(stmt);
+
+        IgniteSqlExecute execute = assertInstanceOf(IgniteSqlExecute.class, node);
+
+        assertEquals(List.of("a:1.0.0", "b:2.0.0"), execute.units());
+        assertEquals("{\"x\":1}", execute.args().toValue());
+
+        expectUnparsed(execute, "EXECUTE 'org.example.MyJob' UNITS 'a:1.0.0', 'b:2.0.0' ARGS '{\"x\":1}'");
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {
+            "EXECUTE",
+            "EXECUTE 1",
+            "EXECUTE 'job' UNITS",
+            "EXECUTE 'job' ARGS 1",
+            "EXECUTE 'job' ARGS 'a' UNITS 'u:1'",
+    })
+    public void invalid(String stmt) {
+        assertThrowsSqlException(Sql.STMT_PARSE_ERR, "Failed to parse query", () -> parse(stmt));
+    }
+}
