+    /**
+     * Returns the handler of the SQL {@code EXECUTE} statement: submits the named job to any node, with a string argument and a string
+     * result, through the same (secured, licensed) compute facade the public API uses.
+     */
+    private static ExecuteHandler computeExecuteHandler(IgniteCompute compute, Supplier<Collection<ClusterNode>> nodes) {
+        return command -> {
+            List<DeploymentUnit> units = command.units().stream()
+                    .map(unit -> {
+                        int sep = unit.lastIndexOf(':');
+
+                        if (sep <= 0 || sep == unit.length() - 1) {
+                            throw new IllegalArgumentException("Deployment unit must be 'name:version': " + unit);
+                        }
+
+                        return new DeploymentUnit(unit.substring(0, sep), unit.substring(sep + 1));
+                    })
+                    .collect(Collectors.toList());
+
+            JobDescriptor<String, String> descriptor = JobDescriptor.<String, String>builder(command.jobClassName())
+                    .units(units)
+                    .resultClass(String.class)
+                    .build();
+
+            return compute.executeAsync(JobTarget.anyNode(nodes.get()), descriptor, command.args());
+        };
+    }
