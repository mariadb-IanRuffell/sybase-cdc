+
+/** End-to-end tests of the SQL {@code EXECUTE} statement, which runs a compute job. */
+public class ItSqlExecuteTest extends BaseSqlIntegrationTest {
+    @Override
+    protected int initialNodes() {
+        return 3;
+    }
+
+    @Test
+    void executeReturnsJobResult() {
+        List<List<Object>> rows = sql("EXECUTE '" + EchoJob.class.getName() + "' ARGS 'hello'");
+
+        assertEquals(List.of(List.of("echo:hello")), rows);
+    }
+
+    @Test
+    void executeWithoutArgs() {
+        List<List<Object>> rows = sql("EXECUTE '" + EchoJob.class.getName() + "'");
+
+        assertEquals(List.of(List.of("echo:null")), rows);
+    }
+
+    @Test
+    void executeFromAnyEntryNode() {
+        for (int node = 0; node < initialNodes(); node++) {
+            List<List<Object>> rows = sql(node, null, "EXECUTE '" + EchoJob.class.getName() + "' ARGS 'x'", new Object[0]);
+
+            assertEquals(List.of(List.of("echo:x")), rows);
+        }
+    }
+
+    @Test
+    void unknownJobClassFails() {
+        assertThrows(Exception.class, () -> sql("EXECUTE 'no.such.Job'"));
+    }
+
+    @Test
+    void badUnitFormatFails() {
+        assertThrows(Exception.class, () -> sql("EXECUTE '" + EchoJob.class.getName() + "' UNITS 'oops'"));
+    }
+
+    /** Job that echoes its argument. */
+    public static class EchoJob implements ComputeJob<String, String> {
+        @Override
+        public @Nullable java.util.concurrent.CompletableFuture<String> executeAsync(JobExecutionContext context, @Nullable String arg) {
+            return java.util.concurrent.CompletableFuture.completedFuture("echo:" + arg);
+        }
+    }
+}
