diff --git a/modules/sql-engine/src/main/java/org/apache/ignite/internal/sql/engine/sql/IgniteSqlExecute.java b/modules/sql-engine/src/main/java/org/apache/ignite/internal/sql/engine/sql/IgniteSqlExecute.java
new file mode 100644
index 0000000000..c279155956
--- /dev/null
+++ b/modules/sql-engine/src/main/java/org/apache/ignite/internal/sql/engine/sql/IgniteSqlExecute.java
@@ -0,0 +1,124 @@
+/*
+ *  Copyright (C) GridGain Systems. All Rights Reserved.
+ *  _________        _____ __________________        _____
+ *  __  ____/___________(_)______  /__  ____/______ ____(_)_______
+ *  _  / __  __  ___/__  / _  __  / _  / __  _  __ `/__  / __  __ \
+ *  / /_/ /  _  /    _  /  / /_/ /  / /_/ /  / /_/ / _  /  _  / / /
+ *  \____/   /_/     /_/   \_,__/   \____/   \__,_/  /_/   /_/ /_/
+ */
+
+package org.apache.ignite.internal.sql.engine.sql;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import org.apache.calcite.sql.SqlCall;
+import org.apache.calcite.sql.SqlKind;
+import org.apache.calcite.sql.SqlLiteral;
+import org.apache.calcite.sql.SqlNode;
+import org.apache.calcite.sql.SqlNodeList;
+import org.apache.calcite.sql.SqlOperator;
+import org.apache.calcite.sql.SqlWriter;
+import org.apache.calcite.sql.parser.SqlParserPos;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * Parse tree for {@code EXECUTE 'job.class' [UNITS 'unit:version', ...] [ARGS 'argument']} statement.
+ */
+public class IgniteSqlExecute extends SqlCall {
+    /** EXECUTE operator. */
+    protected static class Operator extends IgniteSqlSpecialOperator {
+        protected Operator() {
+            super("EXECUTE", SqlKind.OTHER);
+        }
+
+        /** {@inheritDoc} */
+        @Override
+        public SqlCall createCall(@Nullable SqlLiteral functionQualifier, SqlParserPos pos, @Nullable SqlNode... operands) {
+            return new IgniteSqlExecute(pos, (SqlLiteral) operands[0], (SqlNodeList) operands[1], (SqlLiteral) operands[2]);
+        }
+    }
+
+    private static final Operator OPERATOR = new Operator();
+
+    private final SqlLiteral jobClass;
+
+    private final SqlNodeList units;
+
+    private final @Nullable SqlLiteral args;
+
+    /** Constructor. */
+    public IgniteSqlExecute(SqlParserPos pos, SqlLiteral jobClass, SqlNodeList units, @Nullable SqlLiteral args) {
+        super(pos);
+
+        this.jobClass = Objects.requireNonNull(jobClass, "jobClass");
+        this.units = Objects.requireNonNull(units, "units");
+        this.args = args;
+    }
+
+    /** Job class name. */
+    public SqlLiteral jobClass() {
+        return jobClass;
+    }
+
+    /** Deployment units, each as {@code name:version}. */
+    public List<String> units() {
+        List<String> res = new ArrayList<>(units.size());
+
+        for (SqlNode unit : units) {
+            res.add(((SqlLiteral) unit).getValueAs(String.class));
+        }
+
+        return res;
+    }
+
+    /** Job argument, or {@code null}. */
+    public @Nullable SqlLiteral args() {
+        return args;
+    }
+
+    /** {@inheritDoc} */
+    @Override
+    public SqlOperator getOperator() {
+        return OPERATOR;
+    }
+
+    /** {@inheritDoc} */
+    @Override
+    public List<SqlNode> getOperandList() {
+        List<SqlNode> res = new ArrayList<>(3);
+
+        res.add(jobClass);
+        res.add(units);
+        res.add(args);
+
+        return res;
+    }
+
+    /** {@inheritDoc} */
+    @Override
+    public void unparse(SqlWriter writer, int leftPrec, int rightPrec) {
+        writer.keyword("EXECUTE");
+
+        jobClass.unparse(writer, leftPrec, rightPrec);
+
+        if (units.size() > 0) {
+            writer.keyword("UNITS");
+
+            SqlWriter.Frame frame = writer.startList("", "");
+
+            for (SqlNode unit : units) {
+                writer.sep(",");
+                unit.unparse(writer, leftPrec, rightPrec);
+            }
+
+            writer.endList(frame);
+        }
+
+        if (args != null) {
+            writer.keyword("ARGS");
+
+            args.unparse(writer, leftPrec, rightPrec);
+        }
+    }
+}
